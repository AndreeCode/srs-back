# development | production (produccion: sin /docs, cookies Secure, HSTS, seed sin contrasenas fijas)
APP_ENV=development

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sicna
DB_USER=postgres
DB_PASSWORD=tu_password
# disable | prefer | require | verify-ca | verify-full (produccion con BD remota: require o mas)
DB_SSLMODE=prefer

DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=tu_password

# Obligatorio, minimo 32 caracteres: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

COOKIE_SECURE=false

# Bloqueo tras N contrasenas incorrectas (minutos) y limite de intentos de login por IP por minuto
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT=10
TRUSTED_PROXIES=127.0.0.1,::1
UPLOAD_DIR=uploads

MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_DB=BDHIS_MINSA
MSSQL_USER=
MSSQL_PASSWORD=
# off | request | require (produccion con HIS-MINSA remoto: require)
MSSQL_ENCRYPTION=require
